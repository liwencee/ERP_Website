# ── Application ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public URL of the deployed app (CORS, emails, payment callbacks).
APP_URL=https://your-app.up.railway.app

# ── Database ──────────────────────────────────────────────────
# Railway Postgres injects this automatically when you add the plugin.
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Session (REQUIRED in production) ──────────────────────────
# The app refuses to start in production without a strong secret.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── First admin account (the seed creates it from these) ──────
ADMIN_EMAIL=admin@epraccess.com
ADMIN_PASSWORD=

# Create demo/test accounts? "true" ONLY for local dev. NEVER in production.
SEED_DEMO=false

# ── Dollar Investment plan exchange rate (Naira per US$1) ─────
USD_NGN_RATE=1400

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Contact form (Resend) ───────────────────────────────────────
# API key from https://resend.com — required for the /contact form to send.
RESEND_API_KEY=
# Sender shown to recipients. Until a domain is verified in Resend, use
# their shared sandbox sender: onboarding@resend.dev
RESEND_FROM_EMAIL=EPR Access Website <onboarding@resend.dev>
# Inbox that receives contact-form enquiries.
CONTACT_EMAIL_TO=contact@epraaccess.com

# ── Payments ──────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLW_SECRET_HASH=
SQUADCO_SECRET_KEY=
SQUADCO_ENV=production

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
