# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
# Local dev (SQLite):  DATABASE_URL="file:./dev.db"
# Production (PostgreSQL — get a free DB at neon.tech):
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session (use a long random string in production)
SESSION_SECRET=change-this-to-a-long-random-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLW_SECRET_HASH=your-flutterwave-webhook-hash

# Squad by GTBank
SQUADCO_SECRET_KEY=your-squadco-secret-key
SQUADCO_ENV=sandbox

# Logging
LOG_LEVEL=info
