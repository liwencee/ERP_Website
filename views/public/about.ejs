<!DOCTYPE html>
<html lang="en">
<head>
  <title>About Us | EPR Access Limited</title>
  <%- include('../partials/head') %>
</head>
<body class="public-body">
  <%- include('../partials/public-nav') %>
  <main>
    <%- include('../partials/flash') %>

    <section class="page-hero">
      <div class="container">
        <h1>About EPR Access Limited</h1>
        <p>A trusted Nigerian investment company built on integrity, expertise, and results.</p>
      </div>
    </section>

    <section class="section section-light">
      <div class="container two-col">
        <div class="col-text">
          <h2>Our Story</h2>
          <p>EPR Access Limited was founded with a clear mission: to democratize access to quality investment opportunities for every Nigerian. We believe that wealth creation should not be exclusive to the few.</p>
          <p>Our team of seasoned financial professionals combines decades of experience in real estate, equities, fixed income, and alternative investments to deliver consistent, risk-adjusted returns for our clients.</p>
        </div>
        <div class="col-image" style="display:flex; justify-content:flex-end; padding-right:48px;">
          <img src="/images/team/Dr. Femi Adebayo .jpeg" alt="Dr. Femi Adebayo" class="rounded shadow" style="border-radius:12px; width:250px; height:250px; object-fit:cover;" />
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-header">
          <h2>Our Mission &amp; Values</h2>
        </div>
        <div class="values-grid">
          <div class="value-card">
            <h3>Integrity</h3>
            <p>We operate with complete transparency. Every investment decision and transaction is accountable to our clients.</p>
          </div>
          <div class="value-card">
            <h3>Excellence</h3>
            <p>We pursue the highest standards in investment management, risk assessment, and client service.</p>
          </div>
          <div class="value-card">
            <h3>Growth</h3>
            <p>We are dedicated to growing your wealth consistently while protecting your principal investment.</p>
          </div>
          <div class="value-card">
            <h3>Community</h3>
            <p>We invest in Nigerian enterprises, contributing to economic development and job creation.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section cta-section">
      <div class="container text-center">
        <h2>Join Our Growing Community of Investors</h2>
        <a href="/auth/register" class="btn btn-gold btn-lg">Open an Account</a>
      </div>
    </section>

  </main>
  <%- include('../partials/public-footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
