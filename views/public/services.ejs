<!DOCTYPE html>
<html lang="en">
<head>
  <title>Investment Services | EPR Access Limited</title>
  <%- include('../partials/head') %>
</head>
<body class="public-body">
  <%- include('../partials/public-nav') %>
  <main>
    <%- include('../partials/flash') %>

    <section class="page-hero">
      <div class="container">
        <h1>Our Services</h1>
        <p>A diversified suite of investment and enterprise solutions designed for capital preservation and growth.</p>
      </div>
    </section>

    <!-- Service Verticals -->
    <section class="section section-light">
      <div class="container">
        <div class="section-header stagger">
          <span class="section-eyebrow">What We Do</span>
          <h2>Eleven Sectors, <span class="gradient-text">One Trusted Partner</span></h2>
          <p>From money markets to real estate, agriculture and ICT — manage your entire portfolio in one place</p>
        </div>
        <div class="services-overview-grid stagger">
          <div class="service-card" id="trading">
            <div class="service-icon">📈</div>
            <h3>Trading Market Services</h3>
            <p>Forex, stocks &amp; indices, cryptocurrency and USD-denominated assets — traded with competitive spreads and expert guidance.</p>
          </div>
          <div class="service-card" id="money-market">
            <div class="service-icon">💵</div>
            <h3>Money Market Services</h3>
            <p>Short-term investments, liquidity management and treasury services designed for security, liquidity and steady growth.</p>
          </div>
          <div class="service-card" id="equity">
            <div class="service-icon">📊</div>
            <h3>Equity Services</h3>
            <p>Diversified equity portfolios across agriculture, energy and tech — tap into Nigeria's emerging markets with expert guidance.</p>
          </div>
          <div class="service-card" id="real-estate">
            <div class="service-icon">🏢</div>
            <h3>Real Estate Management</h3>
            <p>Property sales, acquisition, construction, valuation and estate management across Nigeria's $56B real estate market.</p>
          </div>
          <div class="service-card" id="savings">
            <div class="service-icon">🐷</div>
            <h3>Savings Plan</h3>
            <p>Flexible savings with competitive interest rates and tenures. Secure, transparent and built for disciplined wealth accumulation.</p>
          </div>
          <div class="service-card" id="project-financing">
            <div class="service-icon">🤝</div>
            <h3>Project Financing</h3>
            <p>Flexible funding for business expansion and new ventures, backed by expert guidance and competitive terms.</p>
          </div>
          <div class="service-card" id="farming">
            <div class="service-icon">🌾</div>
            <h3>Farming Services</h3>
            <p>Invest in high-yield crops, livestock production, agro-tech solutions and agro-chemicals — sustainable and profitable.</p>
          </div>
          <div class="service-card" id="livestock">
            <div class="service-icon">🐄</div>
            <h3>Livestock Market Services</h3>
            <p>Cattle and poultry farming plus livestock trading with assured returns, animal welfare and market access.</p>
          </div>
          <div class="service-card" id="it">
            <div class="service-icon">💻</div>
            <h3>IT Services</h3>
            <p>Software solutions, website development, data analytics, hardware supply and cybersecurity for modern businesses.</p>
          </div>
          <div class="service-card" id="food-beverage">
            <div class="service-icon">🍞</div>
            <h3>Food &amp; Beverage</h3>
            <p>Bakery, snacks, supermarket essentials and bottled water — bringing quality, convenience and taste to every Nigerian.</p>
          </div>
          <div class="service-card" id="capital">
            <div class="service-icon">💎</div>
            <h3>Capital Investment</h3>
            <p>Structured wealth management across Bronze, Silver, Gold and Diamond tiers — guided by our A-DESIRE standard.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-light" id="plans">
      <div class="container">
        <div class="section-header stagger">
          <span class="section-eyebrow">Investment Plans</span>
          <h2>Available <span class="gradient-text">Investment Plans</span></h2>
          <p>Structured tiers for every capital level — start with as little as ₦10,000</p>
        </div>
        <div class="plans-full-grid">
          <% if (plans.length) { %>
            <% plans.forEach(function(plan) { %>
            <div class="plan-full-card" id="<%= plan.type.toLowerCase().replace('_','-') %>">
              <div class="plan-header">
                <div class="plan-type plan-type-<%= plan.type.toLowerCase().replace('_','-') %>"><%= plan.type.replace('_', ' ') %></div>
                <h3><%= plan.name %></h3>
              </div>
              <p class="plan-description"><%= plan.description %></p>
              <div class="plan-specs">
                <div class="plan-spec"><span>Return Rate</span><strong class="text-gold"><%= plan.returnRate %>% per annum</strong></div>
                <div class="plan-spec"><span>Duration</span><strong><%= plan.duration %> days</strong></div>
                <div class="plan-spec"><span>Min Investment</span><strong>₦<%= Number(plan.minAmount).toLocaleString() %></strong></div>
                <% if (plan.maxAmount) { %>
                <div class="plan-spec"><span>Max Investment</span><strong>₦<%= Number(plan.maxAmount).toLocaleString() %></strong></div>
                <% } %>
              </div>
              <a href="/auth/register" class="btn btn-gold">Get Started</a>
            </div>
            <% }) %>
          <% } else { %>
            <div class="text-center">
              <p>Investment plans are being configured. Please <a href="/contact">contact us</a> for details.</p>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-header stagger">
          <span class="section-eyebrow">Getting Started</span>
          <h2>How It <span class="gradient-text">Works</span></h2>
          <p>Turn your financial goals into measurable results in four simple steps</p>
        </div>
        <div class="steps-grid stagger">
          <div class="step-card">
            <div class="step-num">01</div>
            <h3>Create Your Account</h3>
            <p>Register in minutes to join our platform. Once verified, log in to access all features from one secure dashboard.</p>
          </div>
          <div class="step-card">
            <div class="step-num">02</div>
            <h3>Fund Your Wallet</h3>
            <p>Deposit via bank transfer or card payment through Squad by GTBank — fast, secure and convenient.</p>
          </div>
          <div class="step-card">
            <div class="step-num">03</div>
            <h3>Choose an Investment Plan</h3>
            <p>Select from a range of plans for different goals and risk profiles, with clear guidance from our team.</p>
          </div>
          <div class="step-card">
            <div class="step-num">04</div>
            <h3>Monitor Performance</h3>
            <p>Track your portfolio, contributions and returns in real time. Stay informed and in control at every step.</p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <%- include('../partials/public-footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
