<!DOCTYPE html>
<html lang="en">
<head>
  <title>Investment Services | EPR Access Limited</title>
  <%- include('../partials/head') %>
</head>
<body class="public-body">
  <%- include('../partials/public-nav') %>
  <main>
    <%- include('../partials/flash') %>

    <section class="page-hero">
      <div class="container">
        <h1>Investment Services</h1>
        <p>Diversified investment opportunities for every financial goal.</p>
      </div>
    </section>

    <section class="section section-light" id="plans">
      <div class="container">
        <div class="section-header">
          <h2>Available Investment Plans</h2>
          <p>Start with as little as ₦10,000</p>
        </div>
        <div class="plans-full-grid">
          <% if (plans.length) { %>
            <% plans.forEach(function(plan) { %>
            <div class="plan-full-card" id="<%= plan.type.toLowerCase().replace('_','-') %>">
              <div class="plan-header">
                <div class="plan-type plan-type-<%= plan.type.toLowerCase().replace('_','-') %>"><%= plan.type.replace('_', ' ') %></div>
                <h3><%= plan.name %></h3>
              </div>
              <p class="plan-description"><%= plan.description %></p>
              <div class="plan-specs">
                <div class="plan-spec"><span>Return Rate</span><strong class="text-gold"><%= plan.returnRate %>% per annum</strong></div>
                <div class="plan-spec"><span>Duration</span><strong><%= plan.duration %> days</strong></div>
                <div class="plan-spec"><span>Min Investment</span><strong>₦<%= Number(plan.minAmount).toLocaleString() %></strong></div>
                <% if (plan.maxAmount) { %>
                <div class="plan-spec"><span>Max Investment</span><strong>₦<%= Number(plan.maxAmount).toLocaleString() %></strong></div>
                <% } %>
              </div>
              <a href="/auth/register" class="btn btn-gold">Get Started</a>
            </div>
            <% }) %>
          <% } else { %>
            <div class="text-center">
              <p>Investment plans are being configured. Please <a href="/contact">contact us</a> for details.</p>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-header">
          <h2>How It Works</h2>
        </div>
        <div class="steps-grid">
          <div class="step-card">
            <div class="step-num">01</div>
            <h3>Create Account</h3>
            <p>Register for free and complete your KYC verification in minutes.</p>
          </div>
          <div class="step-card">
            <div class="step-num">02</div>
            <h3>Fund Wallet</h3>
            <p>Deposit funds via bank transfer or Paystack online payment.</p>
          </div>
          <div class="step-card">
            <div class="step-num">03</div>
            <h3>Choose a Plan</h3>
            <p>Select the investment plan that matches your goals and risk appetite.</p>
          </div>
          <div class="step-card">
            <div class="step-num">04</div>
            <h3>Earn Returns</h3>
            <p>Watch your investment grow. Withdraw your returns at maturity.</p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <%- include('../partials/public-footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
