<!DOCTYPE html>
<html lang="en">
<head>
  <title>Real Estate Investment Packages | EPR Access Limited</title>
  <%- include('../partials/head') %>
</head>
<body class="public-body">
  <%- include('../partials/public-nav') %>
  <main>
    <%- include('../partials/flash') %>

    <!-- Hero -->
    <section class="page-hero">
      <div class="container">
        <h1>EPR Access Limited – Real Estate Investment Packages</h1>
        <p>Build wealth through secured real estate-backed investments with EPR Access Limited.</p>
      </div>
    </section>

    <!-- Projected Growth Structure -->
    <section class="section section-dark" id="growth">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">Projected Growth Structure</span>
          <h2>Your Capital <span class="gradient-text">Working For You</span></h2>
          <p>Fixed growth rates on verified real estate projects — full capital plus returns paid at maturity</p>
        </div>
        <div class="investment-detail-grid single-card" style="max-width:680px; margin:0 auto 40px;">
          <div class="inv-detail-card">
            <h3>Real Estate Investment Returns</h3>
            <div class="tenure-breakdown">
              <div class="tenure-row">
                <span>1 Year</span>
                <strong class="text-gold">18% return on capital</strong>
              </div>
              <div class="tenure-row">
                <span>2 Years</span>
                <strong class="text-gold">36% return on capital</strong>
              </div>
              <div class="tenure-row">
                <span>3 Years</span>
                <strong class="text-gold">54% return on capital</strong>
              </div>
              <div class="tenure-row">
                <span>4 Years</span>
                <strong class="text-gold">72% return on capital</strong>
              </div>
              <div class="tenure-row">
                <span>5 Years</span>
                <strong class="text-gold">90% return on capital</strong>
              </div>
            </div>
            <p style="margin-top:24px; color:rgba(255,255,255,0.78); font-size:0.97rem; line-height:1.8;">
              Your capital is deployed into verified real estate projects. At maturity, EPR Access Limited
              pays back your <strong style="color:#fff;">full capital + projected returns</strong> based on the selected tenor.
            </p>
            <a href="/auth/register" class="btn btn-gold" style="margin-top:24px; display:inline-block;">Start Investing</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Investors Choose EPR Access -->
    <section class="section section-light">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">Why Choose Us</span>
          <h2>Why Investors Choose <span class="gradient-text">EPR Access</span></h2>
          <p>Three pillars that make our real estate investment model stand apart</p>
        </div>
        <div class="services-overview-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); max-width:900px; margin:0 auto;">
          <div class="service-card">
            <div class="service-icon">🏢</div>
            <h3>Asset-backed</h3>
            <p>Investments are tied to real property, not speculation. Your capital sits behind tangible, verifiable real estate assets.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">📋</div>
            <h3>Transparent terms</h3>
            <p>Fixed growth structure, clear exit at maturity. You know exactly what you will earn before you invest a single naira.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">✅</div>
            <h3>Disciplined payout</h3>
            <p>Returns are processed as scheduled per your investment agreement — no surprises, no delays in the payout cycle.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- $56B Market Opportunity -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">The Opportunity</span>
          <h2>Nigeria's <span class="gradient-text">$56 Billion</span> Real Estate Market</h2>
        </div>
        <div class="investment-detail-grid single-card" style="max-width:760px; margin:0 auto;">
          <div class="inv-detail-card" style="text-align:center;">
            <p style="font-size:1.05rem; line-height:1.85; color:rgba(255,255,255,0.82); margin:0;">
              Invest in our diversified portfolio of prime Nigeria real estate within a
              <strong style="color:var(--gold);">$56 billion market</strong>.
              Benefit from rental income and capital appreciation through structured project financing
              and equity placement — <em>no direct property management required.</em>
            </p>
            <a href="/auth/register" class="btn btn-gold btn-lg" style="margin-top:32px; display:inline-block;">Create Free Account</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="cta-mesh"></div>
      <div class="container text-center">
        <div class="cta-badge">Build Long-Term Wealth</div>
        <h2 style="color:#fff; margin-bottom:16px;">Ready to Invest in<br><span class="gradient-text">Real Estate?</span></h2>
        <p style="color:rgba(255,255,255,0.65); font-size:1.1rem; margin-bottom:36px; max-width:520px; margin-left:auto; margin-right:auto; line-height:1.7;">
          Create your free account and start growing your wealth with EPR Access Limited's real estate investment packages.
        </p>
        <div class="cta-actions">
          <a href="/auth/register" class="btn btn-gold btn-lg">Create Free Account</a>
          <a href="/contact" class="btn-cta-ghost">Talk to an Advisor</a>
        </div>
      </div>
    </section>

  </main>
  <%- include('../partials/public-footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
