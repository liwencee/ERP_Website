<!DOCTYPE html>
<html lang="en">
<head>
  <title>Our Team | EPR Access Limited</title>
  <%- include('../partials/head') %>
</head>
<body class="public-body">
  <%- include('../partials/public-nav') %>
  <main>
    <%- include('../partials/flash') %>

    <section class="page-hero">
      <div class="container">
        <h1>Our Leadership Team</h1>
        <p>Decades of combined experience in finance, real estate, and investment management.</p>
      </div>
    </section>

    <section class="section section-light">
      <div class="container">
        <div class="team-grid">

          <div class="team-card">
            <div class="team-photo"><img src="/images/team/Dr. Femi Adebayo .jpeg" alt="Dr. Femi Adebayo" style="object-position: center 5%;" /></div>
            <div class="team-info">
              <h3>Dr. Femi Adebayo</h3>
              <span class="team-role">Managing Director / CEO</span>
              <p>Leading EPR Access Limited with over 20 years of experience in investment management and financial advisory.</p>
            </div>
          </div>

          <div class="team-card">
            <div class="team-photo"><img src="/images/team/DR FESTUS OMORUSI.jpeg" alt="Dr. Festus Omorusi" style="object-position: center 5%;" /></div>
            <div class="team-info">
              <h3>Dr. Festus Omorusi</h3>
              <span class="team-role">Executive Director</span>
              <p>Bringing deep expertise in corporate finance and strategic investment portfolio management.</p>
            </div>
          </div>

          <div class="team-card">
            <div class="team-photo"><img src="/images/team/KEHINDE ADEWOYIN.jpeg" alt="Kehinde Adewoyin" /></div>
            <div class="team-info">
              <h3>Kehinde Adewoyin</h3>
              <span class="team-role">Head of Investments</span>
              <p>Specialist in real estate and fixed-income instruments with a track record of superior returns.</p>
            </div>
          </div>

          <div class="team-card">
            <div class="team-photo"><img src="/images/team/GODWIN AIGBE.jpeg" alt="Godwin Aigbe" style="object-position: center 5%;" /></div>
            <div class="team-info">
              <h3>Godwin Aigbe</h3>
              <span class="team-role">Chief Financial Officer</span>
              <p>Overseeing financial operations, compliance, and risk management across all investment portfolios.</p>
            </div>
          </div>

          <div class="team-card">
            <div class="team-photo"><img src="/images/team/TAIWO ADEBAYO .jpeg" alt="Taiwo Adebayo" style="object-position: center 5%;" /></div>
            <div class="team-info">
              <h3>Taiwo Adebayo</h3>
              <span class="team-role">Director of Operations</span>
              <p>Ensuring seamless operations and exceptional client experience across all investor touchpoints.</p>
            </div>
          </div>

          <div class="team-card">
            <div class="team-photo"><img src="/images/team/BABATUNDE FASUYI .jpeg" alt="Babatunde Fasuyi" /></div>
            <div class="team-info">
              <h3>Babatunde Fasuyi</h3>
              <span class="team-role">Head of Risk Management</span>
              <p>Dedicated to protecting investor capital through rigorous risk assessment and mitigation strategies.</p>
            </div>
          </div>

          <div class="team-card">
            <div class="team-photo"><img src="/images/team/TOYIN OGUNMOLA.jpeg" alt="Toyin Ogunmola" /></div>
            <div class="team-info">
              <h3>Toyin Ogunmola</h3>
              <span class="team-role">Client Relations Manager</span>
              <p>Building lasting relationships with investors through transparency, trust, and proactive communication.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
  <%- include('../partials/public-footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
