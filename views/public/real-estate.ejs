<!DOCTYPE html>
<html lang="en">
<head>
  <title>Real Estate Investment Packages | EPR Access Limited</title>
  <%- include('../partials/head') %>
</head>
<body class="public-body">
  <%- include('../partials/public-nav') %>
  <main>
    <%- include('../partials/flash') %>

    <section class="page-hero">
      <div class="container">
        <h1>Real Estate Investment – Compounding Wealth</h1>
        <p>Build wealth through secured real estate-backed investments with EPR Access Limited.</p>
      </div>
    </section>

    <!-- Projected Growth Structure -->
    <section class="section section-dark" id="growth">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">Projected Growth Structure</span>
          <h2>Your Capital <span class="gradient-text">Working For You</span></h2>
          <p>Fixed growth rates on verified real estate projects — full capital plus returns paid at maturity</p>
        </div>
        <div class="investment-detail-grid single-card">
          <div class="inv-detail-card">
            <h3>Real Estate Investment Returns</h3>
            <div class="tenure-breakdown">
              <div class="tenure-row">
                <span>1 Year</span>
                <strong>18% return on capital</strong>
              </div>
              <div class="tenure-row">
                <span>2 Years</span>
                <strong>36% return on capital</strong>
              </div>
              <div class="tenure-row">
                <span>3 Years</span>
                <strong>54% return on capital</strong>
              </div>
              <div class="tenure-row">
                <span>4 Years</span>
                <strong>72% return on capital</strong>
              </div>
              <div class="tenure-row">
                <span>5 Years</span>
                <strong>90% return on capital</strong>
              </div>
            </div>
            <p style="margin-top:24px; color:rgba(255,255,255,0.75); font-size:0.97rem; line-height:1.75;">
              Your capital is deployed into verified real estate projects. At maturity, EPR Access Limited pays back your full capital + projected returns based on the selected tenor.
            </p>
            <a href="/auth/register" class="btn btn-gold" style="margin-top:24px;">Start Investing</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Investors Choose EPR Access -->
    <section class="section section-light">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">Why Choose Us</span>
          <h2>Why Investors Choose <span class="gradient-text">EPR Access</span></h2>
        </div>
        <div class="investment-detail-grid single-card">
          <div class="inv-detail-card">
            <div class="re-services">
              <div class="re-col" style="flex:1;">
                <ul>
                  <li>
                    <strong>Asset-backed</strong><br />
                    Investments are tied to real property, not speculation.
                  </li>
                  <li style="margin-top:16px;">
                    <strong>Transparent terms</strong><br />
                    Fixed growth structure, clear exit at maturity.
                  </li>
                  <li style="margin-top:16px;">
                    <strong>Disciplined payout</strong><br />
                    Returns processed as scheduled per agreement.
                  </li>
                </ul>
              </div>
            </div>
            <p style="margin-top:24px; font-size:0.97rem; line-height:1.75;">
              Invest in our diversified portfolio of prime Nigeria real estate within a $56B market.
              Benefit from rental income and capital appreciation through structured project financing
              and equity placement — no direct property management required.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="cta-mesh"></div>
      <div class="container text-center">
        <div class="cta-badge">Build Long-Term Wealth</div>
        <h2 style="color:#fff; margin-bottom:16px;">Ready to Invest in<br><span class="gradient-text">Real Estate?</span></h2>
        <p style="color:rgba(255,255,255,0.65); font-size:1.1rem; margin-bottom:36px; max-width:520px; margin-left:auto; margin-right:auto; line-height:1.7;">
          Create your free account and start growing your wealth with EPR Access Limited's real estate investment packages.
        </p>
        <div class="cta-actions">
          <a href="/auth/register" class="btn btn-gold btn-lg">Create Free Account</a>
          <a href="/investment-plans" class="btn-cta-ghost">View All Plans</a>
        </div>
      </div>
    </section>

  </main>
  <%- include('../partials/public-footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
