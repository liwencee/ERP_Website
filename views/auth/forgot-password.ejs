<!DOCTYPE html>
<html lang="en">
<head>
  <title>Forgot Password | EPR Access Limited</title>
  <%- include('../partials/head') %>
</head>
<body class="auth-body">
  <div class="auth-container">
    <div class="auth-brand">
      <a href="/" class="nav-logo"><img src="/images/logo.png" alt="EPR Access Limited" class="site-logo site-logo-auth" /></a>
    </div>
    <div class="auth-card">
      <h2>Forgot Password</h2>
      <p class="auth-sub">Enter your email and we'll send you a reset link</p>

      <%- include('../partials/flash') %>

      <form action="/auth/forgot-password" method="POST" class="auth-form">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required placeholder="your@email.com" />
        </div>
        <button type="submit" class="btn btn-gold btn-block">Send Reset Link</button>
      </form>

      <p class="auth-footer"><a href="/auth/login">Back to login</a></p>
    </div>
  </div>
</body>
</html>
