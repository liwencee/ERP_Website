<!DOCTYPE html>
<html lang="en">
<head>
  <title>Reset Password | EPR Access Limited</title>
  <%- include('../partials/head') %>
</head>
<body class="auth-body">
  <div class="auth-container">
    <div class="auth-brand">
      <a href="/" class="nav-logo"><img src="/images/logo.png" alt="EPR Access Limited" class="site-logo site-logo-auth" /></a>
    </div>
    <div class="auth-card">
      <h2>Set New Password</h2>
      <p class="auth-sub">Choose a strong password for your account</p>

      <%- include('../partials/flash') %>

      <form action="/auth/reset-password/<%= token %>" method="POST" class="auth-form">
        <div class="form-group">
          <label for="password">New Password</label>
          <input type="password" id="password" name="password" required placeholder="Min. 8 characters" autocomplete="new-password" />
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirm New Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="Repeat new password" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn btn-gold btn-block">Reset Password</button>
      </form>
    </div>
  </div>
</body>
</html>
