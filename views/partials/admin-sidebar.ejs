<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <a href="/" class="nav-logo">
      <img src="/images/logo.png" alt="EPR Access Limited" class="site-logo site-logo-sidebar" />
    </a>
    <button class="sidebar-close" id="sidebarClose">&times;</button>
  </div>

  <nav class="sidebar-nav">
    <ul>
      <li>
        <a href="/admin" class="sidebar-link <%= currentPath === '/admin' ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Dashboard
        </a>
      </li>
      <li>
        <a href="/admin/users" class="sidebar-link <%= currentPath.startsWith('/admin/users') ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Users
          <% if (locals.pendingKyc > 0) { %><span class="badge badge-warning"><%= pendingKyc %></span><% } %>
        </a>
      </li>
      <li>
        <a href="/admin/investments" class="sidebar-link <%= currentPath.startsWith('/admin/investments') ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          Investments
        </a>
      </li>
      <li>
        <a href="/admin/plans" class="sidebar-link <%= currentPath.startsWith('/admin/plans') ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          Plans
        </a>
      </li>
      <li>
        <a href="/admin/transactions" class="sidebar-link <%= currentPath.startsWith('/admin/transactions') ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Transactions
          <% if (locals.pendingDeposits > 0) { %><span class="badge badge-warning"><%= pendingDeposits %></span><% } %>
        </a>
      </li>
      <% if (user && user.role === 'ADMIN') { %>
      <li>
        <a href="/admin/audit" class="sidebar-link <%= currentPath.startsWith('/admin/audit') ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 15l2 2 4-4"/></svg>
          Audit Log
        </a>
      </li>
      <% } %>
    </ul>

    <div class="sidebar-section-title">Account</div>
    <ul>
      <li>
        <a href="/dashboard/profile" class="sidebar-link <%= currentPath === '/dashboard/profile' ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          My Profile
        </a>
      </li>
      <li>
        <a href="/auth/logout" class="sidebar-link sidebar-logout">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout
        </a>
      </li>
    </ul>
  </nav>
</aside>
