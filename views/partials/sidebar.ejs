<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <a href="/" class="nav-logo">
      <img src="/images/logo.png" alt="EPR Access Limited" class="site-logo site-logo-sidebar" />
    </a>
    <button class="sidebar-close" id="sidebarClose">&times;</button>
  </div>

  <nav class="sidebar-nav">
    <ul>
      <li>
        <a href="/dashboard" class="sidebar-link <%= currentPath === '/dashboard' ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Dashboard
        </a>
      </li>
      <li>
        <a href="/dashboard/investments" class="sidebar-link <%= currentPath.startsWith('/dashboard/investments') ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Investments
        </a>
      </li>
      <li>
        <a href="/dashboard/wallet" class="sidebar-link <%= currentPath === '/dashboard/wallet' ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
          Wallet
        </a>
      </li>
      <li>
        <a href="/dashboard/transactions" class="sidebar-link <%= currentPath === '/dashboard/transactions' ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          Transactions
        </a>
      </li>
      <li>
        <a href="/dashboard/notifications" class="sidebar-link <%= currentPath === '/dashboard/notifications' ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          Notifications
          <% if (unreadCount > 0) { %><span class="badge"><%= unreadCount %></span><% } %>
        </a>
      </li>
    </ul>

    <div class="sidebar-section-title">Account</div>
    <ul>
      <li>
        <a href="/dashboard/profile" class="sidebar-link <%= currentPath === '/dashboard/profile' ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Profile
        </a>
      </li>
      <li>
        <a href="/dashboard/kyc" class="sidebar-link <%= currentPath === '/dashboard/kyc' ? 'active' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          KYC Verification
          <% if (user && user.kycStatus === 'PENDING') { %><span class="badge badge-warning">!</span><% } %>
          <% if (user && user.kycStatus === 'APPROVED') { %><span class="badge badge-success">✓</span><% } %>
        </a>
      </li>
      <li>
        <a href="/auth/logout" class="sidebar-link sidebar-logout">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout
        </a>
      </li>
    </ul>
  </nav>
</aside>
