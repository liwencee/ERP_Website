<!DOCTYPE html>
<html lang="en">
<head>
  <title>User Detail | EPR Access Admin</title>
  <%- include('../../partials/head') %>
</head>
<body class="dashboard-body">
  <%- include('../../partials/admin-sidebar') %>
  <div class="dashboard-main" id="dashboardMain">
    <%- include('../../partials/topbar', { pageTitle: 'User Detail' }) %>
    <div class="dashboard-content">
      <%- include('../../partials/flash') %>

      <a href="/admin/users" class="back-link">← Back to Users</a>

      <div class="admin-user-layout">
        <div class="admin-user-card">
          <div class="user-avatar-lg"><%= profileUser.firstName.charAt(0) %><%= profileUser.lastName.charAt(0) %></div>
          <h2><%= profileUser.firstName %> <%= profileUser.lastName %></h2>
          <p><%= profileUser.email %></p>
          <p><%= profileUser.phone || 'No phone' %></p>
          <div class="user-badges">
            <span class="badge-role role-<%= profileUser.role.toLowerCase() %>"><%= profileUser.role %></span>
            <span class="badge-status status-<%= profileUser.status.toLowerCase() %>"><%= profileUser.status %></span>
            <span class="badge-status status-<%= profileUser.kycStatus.toLowerCase() %>">KYC: <%= profileUser.kycStatus %></span>
          </div>
          <p class="text-muted">Joined: <%= formatDate(profileUser.createdAt) %></p>
          <p class="text-muted">Referral Code: <code><%= profileUser.referralCode || '—' %></code></p>
          <p class="text-muted">Referrals Made: <strong><%= typeof referralCount !== 'undefined' ? referralCount : 0 %></strong></p>
          <p class="text-muted">Total Invested: <strong class="text-gold"><%= formatCurrency(totalInvested) %></strong></p>
          <p class="text-muted">Investment Value (incl. returns): <strong class="text-gold"><%= formatCurrency(totalInvestmentValue) %></strong></p>
          <p class="text-muted">Last Seen: <strong><%= profileUser.lastLoginAt ? formatDateTime(profileUser.lastLoginAt) : 'Never logged in' %></strong></p>
          <div class="admin-actions">
            <form action="/admin/users/<%= profileUser.id %>/status" method="POST">
              <button type="submit" class="btn btn-sm <%= profileUser.status === 'ACTIVE' ? 'btn-danger' : 'btn-gold' %>">
                <%= profileUser.status === 'ACTIVE' ? 'Suspend Account' : 'Activate Account' %>
              </button>
            </form>
            <form action="/admin/users/<%= profileUser.id %>/force-logout" method="POST" class="js-confirm-form" data-confirm="Force logout this user?">
              <button type="submit" class="btn btn-sm btn-outline-gold">Force Logout</button>
            </form>
          </div>
        </div>

        <div class="admin-user-main">
          <div class="dash-section">
            <div class="section-header-row">
              <h3>Wallet</h3>
              <span class="wallet-balance-badge">
                Balance: <strong class="text-gold"><%= formatCurrency(profileUser.wallet ? Number(profileUser.wallet.balance) : 0) %></strong>
              </span>
            </div>

            <!-- Manual Wallet Credit -->
            <div class="manual-credit-box">
              <div class="manual-credit-header">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Manual Wallet Top-Up
                <span class="manual-credit-badge">Admin Override</span>
              </div>
              <p class="manual-credit-note">
                Use this to manually credit the user's wallet when automatic payment confirmation is not working.
                A transaction record will be created and the user will be notified.
              </p>
              <form action="/admin/users/<%= profileUser.id %>/credit-wallet" method="POST" id="creditForm">
                <div class="manual-credit-row">
                  <div class="manual-credit-field">
                    <label for="creditAmount">Amount (₦)</label>
                    <input type="number" id="creditAmount" name="amount"
                           min="100" step="100" placeholder="e.g. 50000" required />
                  </div>
                  <div class="manual-credit-field">
                    <label for="creditDate">Payment Date <span class="text-muted">(optional)</span></label>
                    <input type="date" id="creditDate" name="creditDate"
                           max="<%= new Date().toISOString().slice(0,10) %>" />
                  </div>
                  <div class="manual-credit-field">
                    <label for="creditNote">Note / Reason</label>
                    <input type="text" id="creditNote" name="note"
                           placeholder="e.g. Paid on old platform — ref TXN123" maxlength="120" />
                  </div>
                  <button type="submit" class="btn btn-gold manual-credit-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    Credit Wallet
                  </button>
                </div>
              </form>
            </div>

            <!-- Wallet Debit / Reversal -->
            <div class="manual-credit-box" style="border-color: #c0392b;">
              <div class="manual-credit-header" style="color: #c0392b;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6"/>
                </svg>
                Wallet Reversal (Debit)
                <span class="manual-credit-badge" style="background: rgba(192,57,43,0.12); color: #c0392b;">Admin Override</span>
              </div>
              <p class="manual-credit-note">
                Deduct funds from the user's wallet. The transaction will appear as <strong>REVERSAL</strong>
                in their history and they will be notified. Cannot exceed current balance.
              </p>
              <form action="/admin/users/<%= profileUser.id %>/debit-wallet" method="POST" id="debitForm">
                <div class="manual-credit-row">
                  <div class="manual-credit-field">
                    <label for="debitAmount">Amount (₦)</label>
                    <input type="number" id="debitAmount" name="amount"
                           min="100" step="1" placeholder="e.g. 50000" required />
                  </div>
                  <div class="manual-credit-field">
                    <label for="debitNote">Reason</label>
                    <input type="text" id="debitNote" name="note"
                           placeholder="e.g. Duplicate deposit corrected" maxlength="120" required />
                  </div>
                  <button type="submit" class="btn btn-danger manual-credit-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6"/>
                    </svg>
                    Reverse / Debit
                  </button>
                </div>
              </form>
            </div>
          </div>

          <% if (profileUser.documents.length) { %>
          <div class="dash-section">
            <div class="section-header-row">
              <h3>KYC Documents</h3>
              <div style="display:flex;gap:8px;">
                <form action="/admin/users/<%= profileUser.id %>/kyc" method="POST">
                  <input type="hidden" name="action" value="approve" />
                  <button type="submit" class="btn btn-sm btn-gold">Approve KYC</button>
                </form>
                <form action="/admin/users/<%= profileUser.id %>/kyc" method="POST">
                  <input type="hidden" name="action" value="reject" />
                  <button type="submit" class="btn btn-sm btn-danger">Reject KYC</button>
                </form>
              </div>
            </div>
            <div class="docs-list">
              <% profileUser.documents.forEach(function(doc) { %>
              <div class="doc-item">
                <span class="doc-type"><%= doc.type.replace('_',' ') %></span>
                <a href="<%= doc.url %>" target="_blank" class="btn btn-sm btn-outline-gold">View</a>
                <span class="badge-status status-<%= doc.status.toLowerCase() %>"><%= doc.status %></span>
              </div>
              <% }) %>
            </div>
          </div>
          <% } %>

          <div class="dash-section">
            <div class="section-header-row">
              <h3>Investments (<%= profileUser.investments.length %>)</h3>
              <a href="/admin/users/<%= profileUser.id %>/report" target="_blank" rel="noopener" class="btn btn-sm btn-outline-gold">Download / Print Report</a>
            </div>
            <% if (profileUser.investments.length) { %>
            <div class="table-wrapper">
              <table class="data-table">
                <thead><tr><th>Plan</th><th>Amount</th><th>Expected</th><th>Maturity</th><th>Status</th><th>Action</th></tr></thead>
                <tbody>
                  <% profileUser.investments.forEach(function(inv) { %>
                  <tr>
                    <td><%= planDisplayName(inv.plan.name) %></td>
                    <td><%= formatCurrency(Number(inv.amount)) %></td>
                    <td class="text-gold"><%= formatCurrency(Number(inv.expectedReturn)) %></td>
                    <td><%= formatDate(inv.maturityDate) %></td>
                    <td><span class="badge-status status-<%= inv.status.toLowerCase() %>"><%= inv.status %></span></td>
                    <td>
                      <% if (inv.status === 'ACTIVE' && inv.plan.tenures && inv.plan.tenures.length > 0) { %>
                      <form action="/admin/users/<%= profileUser.id %>/investments/<%= inv.id %>/change-tenure" method="POST" class="js-confirm-form" data-confirm="Change this investment's tenure? Expected return and maturity will be recalculated." style="display:flex;gap:6px;align-items:center;">
                        <select name="tenureId" required>
                          <% inv.plan.tenures.forEach(function (t) { %>
                          <option value="<%= t.id %>" <%= inv.tenureId === t.id ? 'selected' : '' %>><%= t.label %> — <%= Number(t.returnRate) %>%</option>
                          <% }) %>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-gold">Change</button>
                      </form>
                      <% } else { %>
                      <span class="text-muted">—</span>
                      <% } %>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } else { %><p>No investments.</p><% } %>
          </div>

          <div class="dash-section">
            <h3>Recent Transactions</h3>
            <% if (profileUser.transactions.length) { %>
            <div class="table-wrapper">
              <table class="data-table">
                <thead><tr><th>Type</th><th>Amount</th><th>Reference</th><th>Date</th><th>Status</th></tr></thead>
                <tbody>
                  <% profileUser.transactions.forEach(function(tx) { %>
                  <tr>
                    <td><span class="tx-type tx-<%= tx.type.toLowerCase() %>"><%= tx.type %></span></td>
                    <td><%= formatCurrency(Number(tx.amount)) %></td>
                    <td class="mono"><%= tx.reference %></td>
                    <td><%= formatDate(tx.createdAt) %></td>
                    <td><span class="badge-status status-<%= tx.status.toLowerCase() %>"><%= tx.status %></span></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } else { %><p>No transactions.</p><% } %>
          </div>

          <% if (user && user.role === 'ADMIN' && user.id !== profileUser.id && profileUser.role !== 'ADMIN') { %>
          <div class="dash-section danger-zone">
            <div class="section-header-row">
              <h3 style="color:#c0392b;">Danger Zone</h3>
            </div>
            <p class="manual-credit-note">
              Permanently delete this user and <strong>all</strong> associated wallet, transaction,
              investment and KYC records. This <strong>cannot be undone</strong>. An audit-log entry of
              the deletion is retained.
            </p>
            <form action="/admin/users/<%= profileUser.id %>/delete" method="POST" id="deleteUserForm">
              <div class="manual-credit-row">
                <div class="manual-credit-field">
                  <label for="confirmEmail">Type <code><%= profileUser.email %></code> to confirm</label>
                  <input type="text" id="confirmEmail" name="confirmEmail" autocomplete="off"
                         placeholder="<%= profileUser.email %>" data-user-email="<%= profileUser.email %>" />
                </div>
                <button type="submit" class="btn btn-danger manual-credit-btn">Delete User Permanently</button>
              </div>
            </form>
          </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <script src="/js/dashboard.js"></script>
  <script nonce="<%= cspNonce %>">
    (function () {
      // Confirm a manual wallet credit before submitting. (Inline onsubmit is
      // blocked by the Content-Security-Policy, so we wire it here.)
      var creditForm = document.getElementById('creditForm');
      if (creditForm) {
        creditForm.addEventListener('submit', function (e) {
          var amt = document.getElementById('creditAmount').value;
          var when = document.getElementById('creditDate').value;
          var msg = 'Credit ₦' + amt + " to this user's wallet?";
          if (when) msg += '\n\nRecorded as paid on: ' + when;
          if (!window.confirm(msg)) e.preventDefault();
        });
      }

      // Confirm a wallet debit / reversal before submitting.
      var debitForm = document.getElementById('debitForm');
      if (debitForm) {
        debitForm.addEventListener('submit', function (e) {
          var amt = document.getElementById('debitAmount').value;
          var reason = document.getElementById('debitNote').value;
          var msg = 'REVERSE ₦' + amt + " from this user's wallet?\n\nReason: " + reason + '\n\nThis cannot be undone.';
          if (!window.confirm(msg)) e.preventDefault();
        });
      }

      // Delete user — require the typed email to match, then a final confirm.
      var deleteForm = document.getElementById('deleteUserForm');
      if (deleteForm) {
        deleteForm.addEventListener('submit', function (e) {
          var input = document.getElementById('confirmEmail');
          var expected = (input.getAttribute('data-user-email') || '').toLowerCase();
          var typed = (input.value || '').trim().toLowerCase();
          if (typed !== expected) {
            e.preventDefault();
            window.alert('Type the exact email address to confirm deletion.');
            return;
          }
          if (!window.confirm('PERMANENTLY delete this user and ALL their records?\nThis cannot be undone.')) {
            e.preventDefault();
          }
        });
      }

      // Generic confirm-before-submit forms (e.g. force-logout). Replaces a
      // CSP-blocked inline onsubmit handler.
      document.querySelectorAll('.js-confirm-form').forEach(function (f) {
        f.addEventListener('submit', function (e) {
          if (!window.confirm(f.getAttribute('data-confirm') || 'Are you sure?')) e.preventDefault();
        });
      });
    })();
  </script>
</body>
</html>
