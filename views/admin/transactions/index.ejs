<!DOCTYPE html>
<html lang="en">
<head>
  <title>Transactions | EPR Access Admin</title>
  <%- include('../../partials/head') %>
</head>
<body class="dashboard-body">
  <%- include('../../partials/admin-sidebar') %>
  <div class="dashboard-main" id="dashboardMain">
    <%- include('../../partials/topbar', { pageTitle: 'Transactions' }) %>
    <div class="dashboard-content">
      <%- include('../../partials/flash') %>

      <div class="dash-section">
        <div class="section-header-row">
          <h3>All Transactions</h3>
          <form action="/admin/transactions" method="GET" class="search-form">
            <select name="type" class="js-autosubmit">
              <option value="">All Types</option>
              <option value="DEPOSIT" <%= typeFilter === 'DEPOSIT' ? 'selected' : '' %>>Deposit</option>
              <option value="WITHDRAWAL" <%= typeFilter === 'WITHDRAWAL' ? 'selected' : '' %>>Withdrawal</option>
              <option value="INVESTMENT" <%= typeFilter === 'INVESTMENT' ? 'selected' : '' %>>Investment</option>
              <option value="RETURN" <%= typeFilter === 'RETURN' ? 'selected' : '' %>>Return</option>
            </select>
            <select name="status" class="js-autosubmit">
              <option value="">All Statuses</option>
              <option value="PENDING" <%= statusFilter === 'PENDING' ? 'selected' : '' %>>Pending</option>
              <option value="CONFIRMED" <%= statusFilter === 'CONFIRMED' ? 'selected' : '' %>>Confirmed</option>
              <option value="REJECTED" <%= statusFilter === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
            </select>
          </form>
        </div>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>User</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Method / Destination</th>
                <th>Proof</th>
                <th>Reference</th>
                <th>Date</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach(function(tx) { %>
              <tr>
                <td><a href="/admin/users/<%= tx.userId %>"><%= tx.user.firstName %> <%= tx.user.lastName %></a></td>
                <td><span class="tx-type tx-<%= tx.type.toLowerCase() %>"><%= tx.type %></span></td>
                <td><%= formatCurrency(Number(tx.amount)) %></td>
                <td>
                  <% if (tx.type === 'WITHDRAWAL' && tx.bankName) { %>
                    <strong><%= tx.bankName %></strong><br />
                    <span class="mono"><%= tx.bankAccountNumber %></span><br />
                    <small><%= tx.bankAccountName %></small>
                  <% } else { %>
                    <%= tx.paymentMethod || '—' %>
                  <% } %>
                </td>
                <td>
                  <% if (tx.proofUrl) { %>
                  <a href="<%= tx.proofUrl %>" target="_blank" class="btn btn-sm btn-outline-gold">View</a>
                  <% } else { %>—<% } %>
                </td>
                <td class="mono"><%= tx.reference %></td>
                <td><%= formatDate(tx.createdAt) %></td>
                <td><span class="badge-status status-<%= tx.status.toLowerCase() %>"><%= tx.status %></span></td>
                <td>
                  <% if (tx.status === 'PENDING') { %>
                  <form action="/admin/transactions/<%= tx.id %>/confirm" method="POST" style="display:inline" class="js-confirm-backdate">
                    <input type="hidden" name="backdateDate" class="backdate-input" />
                    <button type="submit" class="btn btn-sm btn-gold">Confirm</button>
                  </form>
                  <form action="/admin/transactions/<%= tx.id %>/reject" method="POST" style="display:inline">
                    <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                  </form>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% if (!transactions.length) { %>
        <div class="empty-state"><p>No transactions found.</p></div>
        <% } %>
        <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (page > 1) { %><a href="?page=<%= page-1 %>&type=<%= typeFilter %>&status=<%= statusFilter %>" class="btn btn-sm btn-outline-gold">Previous</a><% } %>
          <span>Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %><a href="?page=<%= page+1 %>&type=<%= typeFilter %>&status=<%= statusFilter %>" class="btn btn-sm btn-outline-gold">Next</a><% } %>
        </div>
        <% } %>
      </div>

    </div>
  </div>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <script src="/js/dashboard.js"></script>
  <script nonce="<%= cspNonce %>">
    (function () {
      // Auto-submit filter selects (replaces CSP-blocked inline onchange).
      document.querySelectorAll('.js-autosubmit').forEach(function (sel) {
        sel.addEventListener('change', function () { this.form.submit(); });
      });

      // Confirm a pending transaction, optionally backdating it (replaces a
      // CSP-blocked inline onsubmit). Not preventing default = the form submits.
      document.querySelectorAll('.js-confirm-backdate').forEach(function (form) {
        form.addEventListener('submit', function () {
          var useBackdate = window.confirm('Backdate this transaction? Click OK to set a custom date, or Cancel to use today.');
          if (useBackdate) {
            var todayStr = new Date().toISOString().slice(0, 10);
            var dateInput = window.prompt('Enter transaction date (YYYY-MM-DD):', todayStr);
            while (dateInput && (isNaN(new Date(dateInput).getTime()) || dateInput > todayStr)) {
              dateInput = window.prompt('That date is invalid or in the future. Enter transaction date (YYYY-MM-DD):', todayStr);
            }
            if (dateInput) form.querySelector('.backdate-input').value = dateInput;
          }
        });
      });
    })();
  </script>
</body>
</html>
